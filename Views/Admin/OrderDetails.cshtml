@model c1Soft_Projesi.Models.SiparisR

@{
    ViewData["Title"] = "Sipariş Detayı";
}

<h1>Sipariş Detayı</h1>
<p><strong>Sipariş No:</strong> @Model.SiparisNo</p>
<p><strong>Sepet No:</strong> @Model.SepetId</p>
<p><strong>Kullanıcı:</strong> @Model.Kullanici?.Username</p>
<p><strong>Tarih:</strong> @Model.Tarih.ToString("dd.MM.yyyy HH:mm")</p>
<p><strong>Durum:</strong> <partial name="_SiparisDurumu" model="Model.SiparisDurumu" /></p>
<p><strong>Adres:</strong> @Model.TeslimatAdresi</p>
@if (!string.IsNullOrWhiteSpace(Model.Notu))
{
    <p><strong>Not:</strong> @Model.Notu</p>
}

<partial name="_SiparisKalemleri" model="Model" />

<a asp-action="Orders" class="btn btn-secondary">Siparişlere Dön</a>
