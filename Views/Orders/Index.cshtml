@model List<c1Soft_Projesi.Models.SiparisR>

@{
    ViewData["Title"] = "Siparişlerim";
}

<h1>Siparişlerim</h1>

@if (Model.Count == 0)
{
    <p>Henüz bir siparişiniz bulunmuyor.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Tarih</th>
                <th>Durum</th>
                <th>Toplam</th>
                <th>Ürünler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var siparis in Model)
            {
                <tr>
                    <td>@siparis.SiparisNo</td>
                    <td>@siparis.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><partial name="_SiparisDurumu" model="siparis.SiparisDurumu" /></td>
                    <td>@siparis.GenelTutar.ToString("N2") TL</td>
                    <td>
                        @foreach (var kalem in siparis.Kalemler)
                        {
                            <div>@kalem.UrunAdi - @kalem.Miktar adet</div>
                        }
                        <a asp-action="Details" asp-route-id="@siparis.SiparisId">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
